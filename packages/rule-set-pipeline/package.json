{
  "name": "@sing-box-config-manager/rule-set-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "配置驱动的规则集交付与版本控制",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:release": "pnpm --filter @sing-box-config-manager/config-compiler generate:validator && node --import tsx --test test/acceptance/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "test:integration": "pnpm --filter @sing-box-config-manager/config-compiler generate:validator && node --import tsx --test test/integration/*.test.ts",
    "rules": "node --import tsx src/cli.ts",
    "test:acceptance:rules": "node --import tsx --test test/acceptance/rules-operations.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ipaddr.js": "2.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@sing-box-config-manager/config-compiler": "workspace:*"
  }
}
