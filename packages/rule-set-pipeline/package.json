{
  "name": "@sing-box-config-manager/rule-set-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "固定 V2Fly Release 的可追溯域名规则构建",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:release": "node --import tsx --test test/acceptance/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:release": "node --import tsx src/cli.ts build",
    "test:integration": "node --import tsx --test test/integration/*.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
