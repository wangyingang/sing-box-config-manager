{
  "name": "sing-box-config-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "sing-box configuration management monorepo",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:tools": "node --test scripts/test/*.test.mjs",
    "check": "pnpm test:tools && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:workspace",
    "smoke:workspace": "node scripts/smoke-workspace.mjs"
  }
}
